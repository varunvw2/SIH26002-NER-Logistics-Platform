# Copy this file to .env and fill in real values before running.
# Never commit the real .env file.

PORT=3000
NODE_ENV=development

# SQLite file path (relative to backend/). Zero-install DB for the hackathon
# prototype. See docs/DATABASE.md for the PostgreSQL+PostGIS migration path.
DATABASE_FILE=./data/sih.db

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# --- External data provider adapters -----------------------------------
# Every provider below falls back to a Mock/Simulation implementation when
# its key is absent, so the whole platform runs with zero paid services.
# Set these only if you have legitimate access - never hardcode keys in code.

# Weather: India Meteorological Department has no public self-serve API key
# system suitable for this; OpenWeatherMap has a free tier as a stand-in.
OPENWEATHER_API_KEY=

# AI image classification: Hugging Face free inference API (optional).
HUGGINGFACE_API_KEY=

# CORS - comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
